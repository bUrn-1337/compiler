Grammar

    0 $accept: Program $end

    1 Program: TranslationUnit
    2        | ε

    3 TranslationUnit: ExternalDecl
    4                | TranslationUnit ExternalDecl

    5 ExternalDecl: FuncDef
    6             | Decl
    7             | IDENTIFIER MUL_OP Pointers PlainInitDeclList ';'
    8             | error ';'
    9             | error '}'

   10 Decl: DeclSpec InitDeclaratorList ';'
   11     | DeclSpec ';'
   12     | IDENTIFIER PlainInitDeclList ';'

   13 PlainInitDeclList: PlainInitDecl
   14                  | PlainInitDeclList ',' PlainInitDecl

   15 PlainInitDecl: PlainDeclarator
   16              | PlainDeclarator ASSIGN Initializer

   17 PlainDeclarator: IDENTIFIER
   18                | PlainDeclarator '[' ']'
   19                | PlainDeclarator '[' CondExpr ']'

   20 DeclSpec: TypeSpec
   21         | TYPEDEF TypeSpec

   22 TypeSpec: INT
   23         | CHAR
   24         | FLOAT
   25         | DOUBLE
   26         | VOID
   27         | TYPE_NAME
   28         | StructUnionSpec
   29         | EnumSpec

   30 StructUnionSpec: StructOrUnion TagName '{' StructDeclList '}'
   31                | StructOrUnion '{' StructDeclList '}'
   32                | StructOrUnion TagName

   33 TagName: IDENTIFIER
   34        | TYPE_NAME

   35 StructOrUnion: STRUCT
   36              | UNION

   37 StructDeclList: Decl
   38               | StructDeclList Decl

   39 EnumSpec: ENUM TagName '{' EnumList '}'
   40         | ENUM '{' EnumList '}'
   41         | ENUM TagName

   42 EnumList: Enumerator
   43         | EnumList ',' Enumerator

   44 Enumerator: IDENTIFIER
   45           | IDENTIFIER ASSIGN CondExpr

   46 InitDeclaratorList: InitDeclarator
   47                   | InitDeclaratorList ',' InitDeclarator

   48 InitDeclarator: Declarator
   49               | Declarator ASSIGN Initializer

   50 Declarator: Pointers NonEmptyDirect

   51 AbstractDeclarator: Pointers DirectDeclarator

   52 DirectDeclarator: ε
   53                 | NonEmptyDirect

   54 NonEmptyDirect: IDENTIFIER
   55               | TYPE_NAME
   56               | '(' ParenContent ')'
   57               | DirectDeclarator '[' ']'
   58               | DirectDeclarator '[' CondExpr ']'
   59               | NonEmptyDirect '(' ParamList ')'

   60 ParenContent: GroupedDeclarator
   61             | ParamList

   62 GroupedDeclarator: PtrStars DirectDeclarator
   63                  | GroupDirect

   64 GroupDirect: IDENTIFIER
   65            | '(' ParenContent ')'
   66            | GroupDirectOpt '[' ']'
   67            | GroupDirectOpt '[' CondExpr ']'
   68            | GroupDirect '(' ParamList ')'

   69 GroupDirectOpt: ε
   70               | GroupDirect

   71 Pointers: ε
   72         | PtrStars

   73 PtrStars: MUL_OP
   74         | PtrStars MUL_OP

   75 Initializer: AssignExpr
   76            | '{' '}'
   77            | '{' InitializerList '}'
   78            | '{' InitializerList ',' '}'

   79 InitializerList: Initializer
   80                | InitializerList ',' Initializer

   81 FuncDef: DeclSpec Declarator CompoundStmt

   82 ParamList: ε
   83          | ParamDeclList

   84 ParamDeclList: ParamDecl
   85              | ParamDeclList ',' ParamDecl

   86 ParamDecl: DeclSpec AbstractDeclarator

   87 CompoundStmt: '{' '}'
   88             | '{' BlockItemList '}'
   89             | '{' error '}'

   90 BlockItemList: BlockItem
   91              | BlockItemList BlockItem

   92 BlockItem: Decl
   93          | Stmt
   94          | error ';'

   95 Stmt: CompoundStmt
   96     | ExprStmt
   97     | SelectionStmt
   98     | IterStmt
   99     | JumpStmt
  100     | LabeledStmt

  101 ExprStmt: ';'
  102         | Expr ';'

  103 SelectionStmt: IF '(' Expr ')' Stmt
  104              | IF '(' Expr ')' Stmt ELSE Stmt
  105              | SWITCH '(' Expr ')' Stmt
  106              | IF '(' error ')' Stmt
  107              | SWITCH '(' error ')' Stmt
  108              | IF '(' error ';'
  109              | SWITCH '(' error ';'
  110              | IF '(' error CompoundStmt
  111              | SWITCH '(' error CompoundStmt

  112 IterStmt: WHILE '(' Expr ')' Stmt
  113         | DO Stmt WHILE '(' Expr ')' ';'
  114         | UNTIL '(' Expr ')' Stmt
  115         | FOR '(' ForInit ExprStmt ')' Stmt
  116         | FOR '(' ForInit ExprStmt Expr ')' Stmt
  117         | WHILE '(' error ')' Stmt
  118         | UNTIL '(' error ')' Stmt
  119         | FOR '(' error ')' Stmt
  120         | WHILE '(' error ';'
  121         | UNTIL '(' error ';'
  122         | WHILE '(' error CompoundStmt
  123         | UNTIL '(' error CompoundStmt
  124         | FOR '(' error CompoundStmt

  125 ForInit: ExprStmt
  126        | Decl

  127 LabeledStmt: IDENTIFIER ':' Stmt
  128            | TYPE_NAME ':' Stmt
  129            | CASE CondExpr ':' Stmt
  130            | DEFAULT ':' Stmt
  131            | CASE error ':' Stmt

  132 JumpStmt: GOTO IDENTIFIER ';'
  133         | GOTO TYPE_NAME ';'
  134         | CONTINUE ';'
  135         | BREAK ';'
  136         | RETURN ';'
  137         | RETURN Expr ';'

  138 Expr: AssignExpr
  139     | Expr ',' AssignExpr

  140 AssignExpr: CondExpr
  141           | CondExpr AssignOp AssignExpr

  142 AssignOp: ASSIGN
  143         | ADD_ASSIGN
  144         | SUB_ASSIGN
  145         | MUL_ASSIGN
  146         | DIV_ASSIGN
  147         | MOD_ASSIGN
  148         | AND_ASSIGN
  149         | OR_ASSIGN
  150         | XOR_ASSIGN
  151         | LEFT_ASSIGN
  152         | RIGHT_ASSIGN

  153 CondExpr: LogOrExpr
  154         | LogOrExpr '?' Expr ':' CondExpr

  155 LogOrExpr: LogAndExpr
  156          | LogOrExpr LOG_OR LogAndExpr

  157 LogAndExpr: BitOrExpr
  158           | LogAndExpr LOG_AND BitOrExpr

  159 BitOrExpr: BitXorExpr
  160          | BitOrExpr BIT_OR BitXorExpr

  161 BitXorExpr: BitAndExpr
  162           | BitXorExpr BIT_XOR BitAndExpr

  163 BitAndExpr: EqExpr
  164           | BitAndExpr BIT_AND EqExpr

  165 EqExpr: RelExpr
  166       | EqExpr EQ_OP RelExpr
  167       | EqExpr NE_OP RelExpr

  168 RelExpr: ShiftExpr
  169        | RelExpr LT_OP ShiftExpr
  170        | RelExpr GT_OP ShiftExpr
  171        | RelExpr LE_OP ShiftExpr
  172        | RelExpr GE_OP ShiftExpr

  173 ShiftExpr: AddExpr
  174          | ShiftExpr LEFT_OP AddExpr
  175          | ShiftExpr RIGHT_OP AddExpr

  176 AddExpr: MulExpr
  177        | AddExpr ADD_OP MulExpr
  178        | AddExpr SUB_OP MulExpr

  179 MulExpr: CastExpr
  180        | MulExpr MUL_OP CastExpr
  181        | MulExpr DIV_OP CastExpr
  182        | MulExpr MOD_OP CastExpr

  183 CastExpr: UnaryExpr
  184         | '(' TypeName ')' CastExpr

  185 UnaryExpr: PostfixExpr
  186          | INC_OP UnaryExpr
  187          | DEC_OP UnaryExpr
  188          | ADD_OP CastExpr
  189          | SUB_OP CastExpr
  190          | LOG_NOT CastExpr
  191          | BIT_NOT CastExpr
  192          | BIT_AND CastExpr
  193          | MUL_OP CastExpr
  194          | SIZEOF UnaryExpr
  195          | SIZEOF '(' TypeName ')'

  196 PostfixExpr: PrimaryExpr
  197            | PostfixExpr '[' Expr ']'
  198            | PostfixExpr '(' ')'
  199            | PostfixExpr '(' ArgList ')'
  200            | PostfixExpr '(' error ')'
  201            | PostfixExpr DOT IDENTIFIER
  202            | PostfixExpr ARROW IDENTIFIER
  203            | PostfixExpr DOT TYPE_NAME
  204            | PostfixExpr ARROW TYPE_NAME
  205            | PostfixExpr INC_OP
  206            | PostfixExpr DEC_OP

  207 PrimaryExpr: IDENTIFIER
  208            | ICONST
  209            | FCONST
  210            | CCONST
  211            | SCONST
  212            | '(' Expr ')'

  213 ArgList: AssignExpr
  214        | ArgList ',' AssignExpr

  215 TypeName: TypeSpec AbstractDeclarator


