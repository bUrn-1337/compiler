# makefile -- mipscc, the C-subset to MIPS (spim) compiler (stage 4)
#
#   make              build build/mipscc
#   make asan         build build/mipscc-asan (AddressSanitizer + UBSan)
#   make tools        build build/irsim, the IR interpreter used by tools/difftest.sh
#   make test         run ./run.sh (every test on spim)
#   make check        tools/check_comments.py + tools/check_asm.py over the tests
#   make memcheck     tools/memcheck.sh: ASan/UBSan and valgrind over every input
#   make clean        remove build/
#
# The runtime library is written in the compiler's own source language
# (src/runtime/rt_lib.c), so it is built in three steps, all inside build/:
#   1. build/stage0/mipscc   -- the compiler with an EMPTY runtime table
#   2. build/rt_lib.s        -- stage0 compiles rt_lib.c in runtime mode (-O1)
#   3. build/rt_table.cpp    -- rt_core.s and rt_lib.s embedded as two string
#                               literals; linked into the final build/mipscc
# Nothing is ever generated inside src/.

CXX      := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -O2 -g -pthread
DEPFLAGS := -MMD -MP
LEX      := flex
YACC     := bison
YFLAGS   := -Wall -Werror -d -v
SANFLAGS := -fsanitize=address,undefined -fno-omit-frame-pointer

SRC      := src
BUILD    := build
TOOLS    := tools

TARGET   := $(BUILD)/mipscc
STAGE0   := $(BUILD)/stage0/mipscc
ASAN     := $(BUILD)/mipscc-asan
SIM      := $(BUILD)/irsim

GEN      := $(BUILD)/parser.tab.cc $(BUILD)/parser.tab.hh $(BUILD)/lex.yy.cc
OBJS     := $(BUILD)/main.o $(BUILD)/ast.o $(BUILD)/ir.o $(BUILD)/sema.o \
            $(BUILD)/irgen.o $(BUILD)/mips.o $(BUILD)/parser.tab.o $(BUILD)/lex.yy.o
CXXSRCS  := $(SRC)/main.cpp $(SRC)/ast.cpp $(SRC)/ir.cpp $(SRC)/sema.cpp \
            $(SRC)/irgen.cpp $(SRC)/mips.cpp

.PHONY: all asan tools test check memcheck clean

all: $(TARGET)

$(BUILD) $(BUILD)/stage0:
	mkdir -p $@

# ---- generated front end ----
$(BUILD)/parser.tab.cc $(BUILD)/parser.tab.hh: $(SRC)/parser.y | $(BUILD)
	$(YACC) $(YFLAGS) -o $(BUILD)/parser.tab.cc $(SRC)/parser.y

$(BUILD)/lex.yy.cc: $(SRC)/lexer.l $(BUILD)/parser.tab.hh | $(BUILD)
	$(LEX) -o $(BUILD)/lex.yy.cc $(SRC)/lexer.l

# ---- objects ----
$(BUILD)/parser.tab.o: $(BUILD)/parser.tab.cc $(SRC)/ast.h
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -I$(SRC) -I$(BUILD) -c -o $@ $<

# flex's generated scanner trips -Wsign-compare and has an unused function;
# silence only those, for only this file.
$(BUILD)/lex.yy.o: $(BUILD)/lex.yy.cc $(BUILD)/parser.tab.hh $(SRC)/ast.h
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -Wno-sign-compare -Wno-unused-function \
	    -I$(SRC) -I$(BUILD) -c -o $@ $<

$(BUILD)/%.o: $(SRC)/%.cpp $(BUILD)/parser.tab.hh
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -I$(SRC) -I$(BUILD) -c -o $@ $<

# ---- the runtime, embedded in the compiler ----
$(BUILD)/rt_empty.cpp: | $(BUILD)
	printf '#include "mips.h"\nconst char* const kRuntimeCore = "";\nconst char* const kRuntimeLib = "";\n' > $@

$(BUILD)/rt_empty.o: $(BUILD)/rt_empty.cpp $(SRC)/mips.h
	$(CXX) $(CXXFLAGS) -I$(SRC) -c -o $@ $<

$(STAGE0): $(OBJS) $(BUILD)/rt_empty.o | $(BUILD)/stage0
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(BUILD)/rt_empty.o

$(BUILD)/rt_lib.s: $(SRC)/runtime/rt_lib.c $(STAGE0)
	$(STAGE0) --runtime -O1 $(SRC)/runtime/rt_lib.c -o $@

$(BUILD)/rt_table.cpp: $(SRC)/runtime/rt_core.s $(BUILD)/rt_lib.s
	{ printf '#include "mips.h"\nconst char* const kRuntimeCore = R"RT_CORE('; \
	  cat $(SRC)/runtime/rt_core.s; \
	  printf ')RT_CORE";\nconst char* const kRuntimeLib = R"RT_LIB('; \
	  cat $(BUILD)/rt_lib.s; \
	  printf ')RT_LIB";\n'; } > $@

$(BUILD)/rt_table.o: $(BUILD)/rt_table.cpp $(SRC)/mips.h
	$(CXX) $(CXXFLAGS) -I$(SRC) -c -o $@ $<

$(TARGET): $(OBJS) $(BUILD)/rt_table.o
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(BUILD)/rt_table.o

# ---- sanitizer build (same runtime table) ----
asan: $(ASAN)

$(ASAN): $(GEN) $(BUILD)/rt_table.cpp $(CXXSRCS)
	$(CXX) $(CXXFLAGS) $(SANFLAGS) -I$(SRC) -I$(BUILD) \
	    -Wno-sign-compare -Wno-unused-function -o $@ \
	    $(CXXSRCS) $(BUILD)/parser.tab.cc $(BUILD)/lex.yy.cc $(BUILD)/rt_table.cpp

# ---- verification tools (not part of the compiler) ----
tools: $(SIM)

$(SIM): $(TOOLS)/irsim.cpp | $(BUILD)
	$(CXX) $(CXXFLAGS) -o $@ $<

test: $(TARGET)
	./run.sh

check: $(TARGET)
	python3 $(TOOLS)/check_comments.py
	python3 $(TOOLS)/check_asm.py

memcheck:
	sh $(TOOLS)/memcheck.sh

clean:
	rm -rf $(BUILD)

# header dependencies, generated by the compiler
-include $(OBJS:.o=.d)
